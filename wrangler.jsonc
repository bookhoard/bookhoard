{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": "./.open-next/worker.js",
  "name": "bookhoard-demo",
  "compatibility_date": "2024-12-30",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Selects the R2 storage driver at runtime — see src/lib/storage/index.ts.
  // This is a build-time concern too (CLOUDFLARE_BUILD, set in the
  // build:cloudflare scripts) but the app also reads it at request time.
  "vars": {
    "STORAGE_DRIVER": "r2",
    // The demo's book data already lives under this prefix in the bucket
    // (from a since-fixed build that leaked a local .env value here) —
    // pinning it explicitly rather than migrating ~20 books to root.
    "S3_PREFIX": "bookhoard"
  },
  // Backs the app's storage layer when STORAGE_DRIVER=r2 — see
  // src/lib/storage/r2.ts. Binding name must match R2_BUCKET_BINDING.
  "r2_buckets": [
    {
      "binding": "BOOKHOARD_BUCKET",
      "bucket_name": "bookhoard-demo"
    }
  ]
}
