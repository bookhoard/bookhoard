STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=bookhoard
S3_ACCESS_KEY=bookhoard
S3_SECRET_KEY=bookhoard123
LOCAL_STORAGE_PATH=./.data
