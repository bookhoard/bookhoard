# Options: local | s3 (s3 also works for S3-compatible stores like MinIO,
# Cloudflare R2, Backblaze B2 — set S3_ENDPOINT accordingly)
STORAGE_DRIVER=local
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=bookhoard
S3_ACCESS_KEY=bookhoard
S3_SECRET_KEY=bookhoard123
# Only needed for real AWS S3 — must match the bucket's actual region
# (e.g. eu-central-1). Leave unset for MinIO/R2, which use "auto".
S3_REGION=
# Optional — scopes all of Bookhoard's data under this directory in the
# bucket, so you can point it at a bucket you already share with other
# apps (e.g. S3_PREFIX=bookhoard) instead of writing to the bucket root.
S3_PREFIX=
LOCAL_STORAGE_PATH=./.data
SMTP_URL=

# Open Library gives identified requests a 3x higher rate limit (3 req/s vs
# 1 req/s) — set this to your email or a contact URL so metadata/trending
# lookups don't get throttled under real usage.
OPENLIBRARY_CONTACT=
